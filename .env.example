# Local dev: relative path is fine. In production (VPS) this MUST be an
# absolute path, e.g. file:/opt/barbershop-booking/data/prod.db — Next's standalone
# server chdir()s into .next/standalone at runtime, so a relative path there
# silently opens/creates a different, empty database. See DEPLOY.md.
DATABASE_URL="file:./dev.db"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""
RESEND_API_KEY=""
BUSINESS_TIMEZONE="America/Santiago"
# Comma-separated for more than one recipient, e.g. "barbero@x.com,dueño@x.com"
BARBER_EMAIL=""
# No trailing slash. Used to build the self-cancellation link in the
# confirmation email, e.g. https://barberstudio.example.com
APP_BASE_URL="http://localhost:3000"
